def fix {n : ℕ} (f : BFn n) (p : Fin n) (b : Bool) : BFn n :=
  fun x => f (Function.update x p b)

def depends {n : ℕ} (f : BFn n) (p : Fin n) : Prop :=
  ∃ x : Fin n → Bool, fix f p (!x p) x ≠ f x

def nonconstant {n : ℕ} (f : BFn n) : Prop :=
  ∃ x y : Fin n → Bool, f x ≠ f y



lemma arm_lower {n k s : ℕ} {f g : BFn (n+1)} {leaf inner : Fin (n+1)}
    (usesLeaf : depends f leaf)
    (usesInner : ∀ b : Bool, depends (fix f leaf b) inner)
    (vary : nonconstant g)
    (reduce : ∀ b : Bool, fix (fix f leaf b) inner false = g)
    (lower : ∀ t, HasCircuitSize (n+1) g t → k ≤ t)
    (small : HasCircuitSize (n+1) f s) : k + 3 ≤ s := by
  have varySlice (b : Bool) : nonconstant (fix f leaf b) := by
    obtain ⟨x, y, hxy⟩ := vary
    exact ⟨Function.update x inner false, Function.update y inner false, by
      simpa only [← reduce b, fix] using hxy⟩
  obtain ⟨b, t, ht, first⟩ := q141 n f leaf s usesLeaf varySlice small
  have varyTwice : nonconstant (fix (fix f leaf b) inner false) := (reduce b).symm ▸ vary
  obtain ⟨u, hu, second⟩ :=
    q70 n (fix f leaf b) inner false t (usesInner b) varyTwice first
  have hk := lower u (reduce b ▸ second)
  omega

lemma one_lower {n k s : ℕ} {f g : BFn (n+1)} (p : Fin (n+1)) (b : Bool)
    (uses : depends f p) (vary : nonconstant g) (reduce : fix f p b = g)
    (lower : ∀ t, HasCircuitSize (n+1) g t → k ≤ t)
    (small : HasCircuitSize (n+1) f s) : k + 1 ≤ s := by
  have vary' : nonconstant (fix f p b) := reduce.symm ▸ vary
  obtain ⟨u, hu, second⟩ := q70 n f p b s uses vary' small
  have second' : HasCircuitSize (n+1) (fix f p b) u := second
  rw [reduce] at second'
  have hk := lower u second'
  omega

lemma two_lower {n k s : ℕ} {f g0 g1 : BFn (n+1)} (p : Fin (n+1))
    (uses : depends f p) (vary0 : nonconstant g0) (vary1 : nonconstant g1)
    (reduce0 : fix f p false = g0) (reduce1 : fix f p true = g1)
    (lower0 : ∀ t, HasCircuitSize (n+1) g0 t → k ≤ t)
    (lower1 : ∀ t, HasCircuitSize (n+1) g1 t → k ≤ t)
    (small : HasCircuitSize (n+1) f s) : k + 2 ≤ s := by
  have varySlice : ∀ b : Bool, nonconstant (fix f p b) := by
    intro b
    cases b
    · exact reduce0.symm ▸ vary0
    · exact reduce1.symm ▸ vary1
  obtain ⟨b, t, ht, first⟩ := q141 n f p s uses varySlice small
  cases b
  · have first' : HasCircuitSize (n+1) (fix f p false) t := first
    rw [reduce0] at first'
    have hk := lower0 t first'
    omega
  · have first' : HasCircuitSize (n+1) (fix f p true) t := first
    rw [reduce1] at first'
    have hk := lower1 t first'
    omega

def assignment (a : ℕ) (i : Fin 6) : Bool := a.testBit i.val

def F0 (x : Fin 6 → Bool) : Bool := Nat.testBit (4278124202 * 2 ^ 32 + 4277992576) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)

def F1 (x : Fin 6 → Bool) : Bool := Nat.testBit 0xfffcfcc0fffcfcc0 (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)

def F2 (x : Fin 6 → Bool) : Bool := Nat.testBit 0xfffffffffffcfcc0 (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)

set_option maxRecDepth 12000 in
set_option maxHeartbeats 0 in
lemma lower0 (t : ℕ) (h : HasCircuitSize 6 F1 t) : 7 ≤ t := by
  have reduced := yn (![0, 0, 1, 2, 3, 0] : Fin 6 → Fin 4) F1 t h
  apply Srch.C0.base_bound t
  convert reduced using 1
  decide +kernel

set_option maxRecDepth 12000 in
set_option maxHeartbeats 0 in
theorem red1 : ∀ x : Fin 6 → Bool, F2 (Function.update x 5 false) = F1 x := by
  decide +kernel

lemma lower1 (t : ℕ) (h : HasCircuitSize 6 F2 t) : 8 ≤ t := by
  have key := one_lower (n := 5) (f := F2) (g := F1) (k := 7) (s := t) (p := 5) (b := false)
    ⟨assignment 0, by decide⟩ ⟨assignment 0, assignment 6, by decide⟩
    (by funext x; exact red1 x) lower0 h
  omega

set_option maxRecDepth 12000 in
set_option maxHeartbeats 0 in
theorem red2 : ∀ x : Fin 6 → Bool, F0 (Function.update x 0 true) = F2 x := by
  decide +kernel

lemma lower2 (t : ℕ) (h : HasCircuitSize 6 F0 t) : 9 ≤ t := by
  have key := one_lower (n := 5) (f := F0) (g := F2) (k := 8) (s := t) (p := 0) (b := true)
    ⟨assignment 6, by decide⟩ ⟨assignment 0, assignment 6, by decide⟩
    (by funext x; exact red2 x) lower1 h
  omega

def witness : Circuit := ⟨[⟨GateOp.or, [1, 2]⟩, ⟨GateOp.or, [2, 3]⟩, ⟨GateOp.or, [1, 4]⟩, ⟨GateOp.or, [3, 4]⟩, ⟨GateOp.and, [7, 8]⟩, ⟨GateOp.and, [6, 9]⟩, ⟨GateOp.or, [5, 10]⟩, ⟨GateOp.and, [0, 12]⟩, ⟨GateOp.or, [11, 13]⟩], 14⟩

theorem witness_mono : Monotone2 witness := by
  intro g hg
  simp only [witness, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp

theorem witness_size : witness.size = 9 := by decide

set_option maxRecDepth 12000 in
